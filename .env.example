# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
VITE_API_URL=https://mpsa-home-page-background.onrender.com

# MONGODB ATLAS CONNECTION STRING (DB NAME MUST BE mpsa_home_page)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/mpsa_home_page

# JWT & AUTHENTICATION SECRETS
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION

# INITIAL SUPER ADMIN CREDENTIALS (USED BY SEED SCRIPT ONLY)
ADMIN_NAME=MPSA Administrator
ADMIN_EMAIL=admin@mpsaschool.edu.in
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
